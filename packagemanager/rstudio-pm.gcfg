; Posit Package Manager Configuration File
;
; Full Configuration Reference: https://docs.posit.co/rspm/admin/appendix/configuration.html

; -------------- Server Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Server.Settings
; Core server settings including the public URL, data directories, and logging options.
; Server.Address is required if Package Manager is served from a subdirectory, uses
; OpenID Connect authentication, or needs correct URLs for PyPI index pages and API docs.

[Server]

; Public URL for this Posit Package Manager server. If Package Manager is deployed
; behind an HTTP proxy, this should be the URL in terms of that proxy. Required if
; served from a subdirectory (e.g., /rspm) to facilitate generating URLs for rspm CLI,
; Swagger docs, and PyPI simple index pages.
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Server.Address
; TODO: Set to your Package Manager server's public URL
;Address = https://packagemanager.example.com

; DataDir is the directory where Package Manager stores variable data (cache, packages,
; etc.). Change this if you want data on another volume (e.g. larger disk, NFS).
; Default: /var/lib/rstudio-pm
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Server.DataDir
;DataDir = /var/lib/rstudio-pm

; TempDir for temporary files; must not be a subdirectory of DataDir.
; If unset, uses $TMPDIR or /tmp
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Server.TempDir
;TempDir = /tmp

; RVersion sets the R path if you don't want Package Manager to auto-detect it
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Server.RVersion
;RVersion = /opt/R/4.6.1/bin/R

; PythonVersion sets the Python path if you don't want Package Manager to auto-detect it
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Server.PythonVersion
;PythonVersion = /opt/python/3.14.6/bin/python

; -------------- HTTP Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/appendix/configuration.html#http
; HTTP configuration for serving plain (non-TLS) connections. Use this when TLS is
; terminated upstream (e.g. at a load balancer or reverse proxy) or for testing.
; Either HTTP.Listen or HTTPS.Listen is required.

[HTTP]

; Posit Package Manager will listen on this network address for HTTP connections.
; The default port is 4242; set to :80 to serve on the standard HTTP port.
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HTTP.Listen
Listen = :4242

; -------------- HTTPS / TLS Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/appendix/configuration.html#https
; HTTPS configuration including certificates, network binding, and TLS versions. Configure
; HTTPS.Listen plus a Certificate/Key pair to have Package Manager terminate TLS directly.

[HTTPS]

; Posit Package Manager will listen on this network address for HTTPS connections.
; The network address can be of the form :443 or 192.168.0.1:443.
; Either HTTP.Listen or HTTPS.Listen is required.
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HTTPS.Listen
;Listen = ":443"

; Path to a TLS certificate file. If the certificate is signed by a certificate authority,
; the certificate file should be the concatenation of the server's certificate followed
; by the Intermediate and CA's certificate. Must be paired with HTTPS.Key.
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HTTPS.Certificate
; TODO: Set to the path of your TLS certificate file (644, owned by rstudio-pm)
;Certificate = /etc/rstudio-pm/certs/packagemanager.crt

; Path to a private key file corresponding to the certificate specified with HTTPS.Certificate.
; Required when HTTPS.Certificate is specified.
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HTTPS.Key
; TODO: Set to the path of your TLS private key file (600, owned by rstudio-pm, no passphrase)
;Key = /etc/rstudio-pm/certs/packagemanager.key

; MinimumTLS restricts to TLS 1.2 and above for security hardening
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HTTPS.MinimumTLS
;MinimumTLS = 1.2

; -------------- HTTP Redirect Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HttpRedirect.Settings
; Redirects plain HTTP traffic to HTTPS. Set Listen to the HTTP address to redirect from;
; requests are forwarded to the HTTPS.Listen address.

[HTTPRedirect]

; Network address to listen on for plain HTTP requests that are redirected to HTTPS
; https://docs.posit.co/rspm/admin/appendix/configuration.html#HttpRedirect.Listen
;Listen = ":80"

; -------------- Database Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/database.html
; PostgreSQL is recommended for production and high-availability deployments.
; Uncomment and configure for PostgreSQL. Keep the password OUT of the URL: supply it
; separately via Postgres.Password as a base64-encoded encrypted value (use:
; rstudio-pm encrypt).
; SSL: Package Manager defaults to sslmode=prefer (SSL if available, otherwise plaintext).
; For production, append ?sslmode=verify-full to the URL to enforce full server-certificate
; validation (use ?sslmode=disable to turn SSL off).
; https://docs.posit.co/rspm/admin/database.html#ssl

[Database]

; Provider selects the database backend: sqlite (default) or postgres
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Database.Provider
;Provider = postgres

[Postgres]

; TODO: Set to your PostgreSQL host/database (omit the password here)
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Postgres.URL
;URL = "postgres://username@hostname:5432/database_name?sslmode=verify-full"

; TODO: Set to your base64-encoded encrypted password (use: rstudio-pm encrypt)
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Postgres.Password
;Password = "<base64 encrypted password value>"

; -------------- Logging Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Logging.Settings
; The system (server) log is configured in the [Logging] section. Access and service
; logs are configured as Server settings above. The settings below show the documented
; defaults; JSON format is more accessible to programmatic log ingestion.

[Logging]

; SystemLog accepts STDOUT, STDERR, or a file path (or a comma-separated combination)
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Logging.SystemLog
;SystemLog = STDOUT,/var/log/rstudio/rstudio-pm/rstudio-pm.log

; SystemLogLevel accepts ERROR, WARNING, INFO, DEBUG, or TRACE (reloadable without a restart)
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Logging.SystemLogLevel
;SystemLogLevel = INFO

; SystemLogFormat accepts TEXT, STRUCTURED, or JSON
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Logging.SystemLogFormat
;SystemLogFormat = TEXT

; -------------- Proxy Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/proxy.html
; Configure outbound proxy for accessing external repositories (CRAN, PyPI, etc.).
; Required if Package Manager cannot directly access the internet.

[Proxy]

; TODO: Set if Package Manager must reach external repos through an outbound proxy
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Proxy.URL
;URL = http://proxy.company.com:3128

; Username sent in the Proxy-Authorization header for outbound proxy authentication
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Proxy.User
;User = proxy-user

; Password sent in the Proxy-Authorization header for outbound proxy authentication
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Proxy.Password
;Password = proxy-password

; -------------- Manifest Service Configuration -------------- ;
;
; https://docs.posit.co/rspm/admin/appendix/configuration.html#manifest
; Points Package Manager at the manifest service used to sync repository metadata.
; Leave unset unless you want to pull manifest data from your own server or proxy
; (e.g. an internal mirror). For fully offline/air-gapped installs, use the offline
; downloader workflow instead: https://docs.posit.co/rspm/admin/appendix/air-gapped-installs.html

[Manifest]

; URL of the manifest service. Default: https://rspm-sync.rstudio.com
; Point at your own server/proxy, or for offline/air-gapped installs set it to a
; file:// path to the offline data directory created by the offline downloader.
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Manifest.URL
; https://docs.posit.co/rspm/admin/appendix/air-gapped-installs.html#configuring-package-manager
;URL = https://manifest.example.com
;URL = file:///var/lib/rspm-offline-data

; User for the Authorization header when the manifest service requires authentication
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Manifest.User
;User = manifest-user

; Password (base64-encoded encrypted value) for the Authorization header (use: rstudio-pm encrypt)
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Manifest.Password
;Password = "<base64 encrypted password value>"

; AllowRedirect enables 307 redirects to underlying package repositories, letting clients
; download packages directly instead of through the Package Manager cache. Default: false
; https://docs.posit.co/rspm/admin/appendix/configuration.html#Manifest.AllowRedirect
;AllowRedirect = false
